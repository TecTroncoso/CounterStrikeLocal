# Copy this file to .env and fill in the three values.
# The token needs the "Cloudflare Pages: Edit" permission.  If you use R2 for
# the archive, add "R2: Edit" as well.

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
PAGES_PROJECT=cs16-browser

# Optional.  Must end with a slash.  Use it when the parts live on R2 or on a
# custom domain; the default keeps them next to index.html.
PARTS_BASE_URL=./valve-parts/
